<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+. App data never leaves the device: no cloud backup and no
   device-to-device transfer. Keep in sync with the Privacy Policy (docs/index.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
